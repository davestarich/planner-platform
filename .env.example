# Copy this file to .env and fill in your real key. The .env file is gitignored,
# so your key stays on your machine and never gets committed.
# Get a free FRED API key at https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# Valid API keys for the public API (comma-separated), one per developer-customer.
# Generate one with: node -e "console.log('plnr_' + require('crypto').randomBytes(24).toString('hex'))"
PLANNER_API_KEYS=
